{
  "name": "literag-mcp",
  "version": "0.2.0",
  "description": "Markdown knowledge-base MCP server with Chroma + SQLite hybrid retrieval",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "MCP_TRANSPORT=stdio tsx src/server.ts",
    "dev:stdio": "MCP_TRANSPORT=stdio tsx src/server.ts",
    "dev:http": "MCP_TRANSPORT=streamable-http tsx src/server.ts",
    "start": "MCP_TRANSPORT=stdio node dist/server.js",
    "start:stdio": "MCP_TRANSPORT=stdio node dist/server.js",
    "start:http": "MCP_TRANSPORT=streamable-http node dist/server.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "markdown",
    "chromadb",
    "sqlite",
    "retrieval"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "chromadb": "^3.4.3",
    "express": "^5.1.0",
    "minimatch": "^10.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
